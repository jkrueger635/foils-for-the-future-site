---
import { money } from '../data/site';
---
<section class="money">
  <div class="wrap">
    <h2 class="h2">{money.title}</h2>
    {money.paragraphs.map((p) => <p class="money__intro">{p}</p>)}
    <div class="money__cards">
      {money.cards.map((c) => (
        <div class="money__card"><h3>{c.title}</h3><p>{c.body}</p></div>
      ))}
    </div>
  </div>
</section>
