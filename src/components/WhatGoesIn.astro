---
import { box } from '../data/site';
---
<section class="box">
  <div class="wrap">
    <h2 class="h2">{box.title}</h2>
    <div class="yn">
      <div class="yn__card yn__card--yes">
        <div class="yn__head">
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#4A3E3E" /><path d="M11 20.5l6 6 12-13" fill="none" stroke="#F2E0D9" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <h3>{box.yesLabel}</h3>
        </div>
        <div class="chips">{box.yes.map((t) => <span class="chip">{t}</span>)}</div>
      </div>
      <div class="yn__card yn__card--no">
        <div class="yn__head">
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#F2E0D9" /><path d="M13 13l14 14M27 13L13 27" fill="none" stroke="#633E70" stroke-width="4" stroke-linecap="round" /></svg>
          <h3>{box.noLabel}</h3>
        </div>
        <div class="chips">{box.no.map((t) => <span class="chip">{t}</span>)}</div>
      </div>
    </div>
    <p class="box__note">{box.note}</p>
  </div>
</section>
