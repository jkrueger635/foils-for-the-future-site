---
import { recruit } from '../data/site';
---
<section class="recruit">
  <div class="wrap">
    <h2 class="h2">{recruit.title}</h2>
    <p class="lead">{recruit.body}</p>
    <div class="two">
      {recruit.campuses.map((c) => (
        <div class="campus">
          <h3>{c.name}</h3>
          <p>{c.lines[0]}<br />{c.lines[1]}</p>
          <a href={c.href} class="btn btn--plum">{c.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>
